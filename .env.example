APP_NAME="Space Wiki"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=space_wiki
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Identity Provider (OpenID Connect)
IDENTITY_OPENID_CONFIGURATION=https://identity.eurofurence.org/.well-known/openid-configuration
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=
IDENTITY_CALLBACK_URL=http://localhost/auth/callback

# Wiki Access Control (comma-separated group IDs)
WIKI_ALLOWED_GROUP_IDS=

# DokuWiki Configuration (DOKUWIKI_TOKEN preferred over username/password)
DOKUWIKI_URI=https://wiki.eurofurence.org
DOKUWIKI_TOKEN=
DOKUWIKI_USERNAME=
DOKUWIKI_PASSWORD=
DOKUWIKI_JSONRPC_ENDPOINT=/lib/exe/jsonrpc.php

# Search (Typesense)
SCOUT_DRIVER=typesense
TYPESENSE_API_KEY=
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http

VITE_APP_NAME="${APP_NAME}"
